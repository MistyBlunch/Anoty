# Copia este archivo a .env y completa los valores
# cp .env.template .env

# Puerto y Host del servidor backend (0.0.0.0 escucha en todas las interfaces, necesario para Docker y Cloud Run)
PORT=3000
HOST=0.0.0.0

# URI de conexión a MongoDB (local o MongoDB Atlas)
MONGODB_URI=

# Google OAuth - ID de cliente de la consola de Google Cloud
GOOGLE_CLIENT_ID=

# Secreto para firmar los JWT de sesión (genera uno con: openssl rand -hex 32)
JWT_SECRET=

# Resend - Notificaciones por correo electrónico
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_LOCALE=en

# URL base de la aplicación (para enlaces en correos)
APP_URL=

# Redis - Escalabilidad horizontal de WebSockets (opcional: si no se define, opera en memoria local)
# Ejemplos: redis://localhost:6379, rediss://default:token@host.upstash.io:6379
REDIS_URL=