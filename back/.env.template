# Copia este archivo a .env y completa los valores
# cp .env.template .env

# Puerto del servidor backend
PORT=3000

# URI de conexión a MongoDB (local o MongoDB Atlas)
MONGODB_URI=

# Google OAuth - ID de cliente de la consola de Google Cloud
GOOGLE_CLIENT_ID=

# Secreto para firmar los JWT de sesión (genera uno con: openssl rand -hex 32)
JWT_SECRET=

# Resend - Notificaciones por correo electrónico
RESEND_API_KEY=
RESEND_FROM_EMAIL=Anoty <onboarding@resend.dev>
EMAIL_LOCALE=en

# URL base de la aplicación (para enlaces en correos)
APP_URL=http://localhost:3000